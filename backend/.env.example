# ══════════════════════════════════════════════════════════════════════════════
# AI Sales Automation Platform — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="AI Sales Automation Platform"
APP_VERSION="0.1.0"
APP_ENV=development          # development | staging | production
DEBUG=false

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-64-char-random-secret-key-before-deploying!!
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON list of allowed origins
CORS_ORIGINS=["http://localhost:4200","http://localhost:3000"]

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salesautomation
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_MAX_RETRIES=3

# ── LLM / OpenAI ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=sendgrid     # sendgrid | smtp
SENDGRID_API_KEY=SG....
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=hello@yourdomain.com
DEFAULT_FROM_NAME="Your Company"

# ── Agent Settings ────────────────────────────────────────────────────────────
AGENT_DEFAULT_TIMEOUT_SECONDS=120
AGENT_MAX_RETRIES=3
AGENT_CONFIDENCE_THRESHOLD=0.7

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console          # console | json (use json in staging/production)
