# Local development; Docker Compose already supplies isolated defaults.
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql+asyncpg://salesway:local-development-password@localhost:15432/salesway
WORKER_MODE=inline
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CORS_ORIGINS=["http://localhost:4202"]
SECRET_KEY=change-me-generate-a-random-secret-before-deployment
API_TOKEN=
WEBHOOK_SECRET=local-development-webhook-secret
PUBLIC_BASE_URL=http://localhost:8000
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMAIL_PROVIDER=local
CALENDAR_PROVIDER=local
LIVE_DELIVERY_ENABLED=false
LOCAL_MAIL_DIR=var/mailbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls
DEFAULT_FROM_EMAIL=
DEFAULT_FROM_NAME=Salesway
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
LOG_LEVEL=INFO
LOG_FORMAT=console
WORKER_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=600

# Business discovery (fresh search does not need a dataset)
APIFY_API_TOKEN=
APIFY_DATASET_ID=
APIFY_ACTOR_ID=compass/crawler-google-places
DISCOVERY_DAILY_LIMIT=100
DISCOVERY_RUN_BUDGET_USD=0.50
DISCOVERY_AI_MAX_CALLS=20
WEBSITE_MAX_PAGES=4
WEBSITE_TIMEOUT_SECONDS=12
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=40
# For Groq instead: GROQ_API_KEY=..., LLM_BASE_URL=https://api.groq.com/openai/v1,
# LLM_MODEL=openai/gpt-oss-20b. Never put server keys in Angular.
