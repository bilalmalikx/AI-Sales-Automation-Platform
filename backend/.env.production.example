# Supply values through your secret manager; never commit the populated file.
APP_ENV=production
DEBUG=false
SECRET_KEY=
API_TOKEN=
WEBHOOK_SECRET=
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@DATABASE_HOST:5432/salesway
CELERY_BROKER_URL=redis://REDIS_HOST:6379/1
CELERY_RESULT_BACKEND=redis://REDIS_HOST:6379/2
WORKER_MODE=celery
PUBLIC_BASE_URL=https://api.example.com
CORS_ORIGINS=["https://app.example.com"]
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls
DEFAULT_FROM_EMAIL=
DEFAULT_FROM_NAME=Salesway
CALENDAR_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Set true after credentials and sender/calendar ownership are configured.
LIVE_DELIVERY_ENABLED=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Business discovery: separate provider charge and qualification-call ceilings.
APIFY_API_TOKEN=
APIFY_DATASET_ID=
APIFY_ACTOR_ID=compass/crawler-google-places
DISCOVERY_DAILY_LIMIT=100
DISCOVERY_RUN_BUDGET_USD=0.50
DISCOVERY_AI_MAX_CALLS=20
WEBSITE_MAX_PAGES=4
WEBSITE_TIMEOUT_SECONDS=12
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=40
